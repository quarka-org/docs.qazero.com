{
    "allpv": {
        "grain": "1 row = 1 pageview",
        "supports_all": true,
        "blurb": "Raw data for every pageview. Behavioral signals such as deep read, exit position and rage clicks sit on the same row.",
        "groups": [
            {
                "fam": "Keys & IDs",
                "kind": "key",
                "desc": "Identifiers used for joins and filtering. You normally filter on resolved columns such as url or device_type instead.",
                "cols": [
                    {
                        "n": "pv_id",
                        "note": "Pageview identifier. Join key against click_event and others.",
                        "type": "uint32",
                        "join": 1
                    },
                    {
                        "n": "session_id",
                        "note": "Filter by session. Fast via the column DB binary scan.",
                        "type": "uint64",
                        "join": 1
                    },
                    {
                        "n": "reader_id",
                        "note": "Filter by user. Usually combined with url or similar.",
                        "type": "uint32",
                        "join": 1
                    },
                    {
                        "n": "page_id",
                        "note": "Per page. You normally filter on url and use page_id as the join key.",
                        "type": "uint32",
                        "join": 1
                    },
                    {
                        "n": "device_id",
                        "note": "Device ID. 1=PC, 2=tablet, 3=SP. The label is device_type.",
                        "type": "uint8"
                    },
                    {
                        "n": "source_id",
                        "note": "Source ID. The label is utm_source.",
                        "type": "uint32"
                    },
                    {
                        "n": "medium_id",
                        "note": "Medium ID. The label is utm_medium.",
                        "type": "uint32"
                    },
                    {
                        "n": "campaign_id",
                        "note": "Campaign ID. The label is utm_campaign.",
                        "type": "uint32"
                    },
                    {
                        "n": "content_id",
                        "note": "Content ID. The label is utm_content.",
                        "type": "uint32"
                    },
                    {
                        "n": "version_id",
                        "note": "Page version ID. Used for A/B and version comparison.",
                        "type": "uint32"
                    },
                    {
                        "n": "prev_page_id",
                        "note": "Previous page ID. 0 selects landing pageviews.",
                        "type": "uint32",
                        "since": "2026-04-17"
                    },
                    {
                        "n": "next_page_id",
                        "note": "Next page ID. 0 selects exit pageviews.",
                        "type": "uint32",
                        "since": "2026-04-17"
                    }
                ]
            },
            {
                "fam": "Session basics",
                "kind": "signal",
                "desc": "Basic browsing metrics. Range filters work here (browse_sec gte:30, for example).",
                "cols": [
                    {
                        "n": "access_time",
                        "note": "UNIX time. Normally handled for you by the period parameters. You can also filter by time of day.",
                        "type": "uint32"
                    },
                    {
                        "n": "month",
                        "note": "Month the row belongs to (YYYY-MM). A virtual column derived from access_time on the site clock. Put it in keep to aggregate by month, which is the only way to build a monthly trend. Narrow the period with time instead; filtering on this column runs as a slow post_filter.",
                        "since": "2026-08-05"
                    },
                    {
                        "n": "pv",
                        "note": "Pageview number within the session (1 = landing).",
                        "type": "uint16"
                    },
                    {
                        "n": "speed_msec",
                        "note": "Load speed in ms. Lets you pull pageviews that took 3 seconds or more.",
                        "type": "uint16"
                    },
                    {
                        "n": "browse_sec",
                        "note": "Time on page, in seconds.",
                        "type": "uint16"
                    },
                    {
                        "n": "is_last",
                        "note": "Last pageview of the session (0/1). For finding exit pages.",
                        "type": "uint8"
                    },
                    {
                        "n": "is_newuser",
                        "note": "New user (0/1).",
                        "type": "uint8"
                    }
                ]
            },
            {
                "fam": "Read depth",
                "kind": "signal",
                "desc": "Per-pageview scroll reach, deep read and where the reader stopped.",
                "cols": [
                    {
                        "n": "depth_position",
                        "note": "Deepest scroll reach, 0-100%. gte:80 means read to the bottom, lte:20 means left near the top.",
                        "type": "uint8",
                        "star": 1
                    },
                    {
                        "n": "deep_read",
                        "note": "Deep-read flag. 1 when there are 5 or more spots held for 3 seconds or longer.",
                        "type": "uint8",
                        "star": 1
                    },
                    {
                        "n": "stop_max_sec",
                        "note": "Longest pause, in seconds. The spot the reader stayed on longest.",
                        "type": "uint16"
                    },
                    {
                        "n": "stop_max_pos",
                        "note": "Position of the longest pause, 0-100%. Goes with stop_max_sec.",
                        "type": "uint8"
                    },
                    {
                        "n": "exit_pos",
                        "note": "Exit position, 0-100%. lte:30 means the reader left within the first screen.",
                        "type": "uint8",
                        "star": 1
                    }
                ],
                "star": 1
            },
            {
                "fam": "Frustration",
                "kind": "signal",
                "desc": "Rage clicks, dead clicks and form submits. Signals of friction with the UI.",
                "cols": [
                    {
                        "n": "irritation_click_count",
                        "note": "Number of rage-click bursts: 5 or more clicks within 3 seconds. gte:1 means friction with the UI.",
                        "type": "uint8",
                        "star": 1
                    },
                    {
                        "n": "dead_click_image_count",
                        "note": "Clicks on images that carry no link. gte:1 means a missed opportunity.",
                        "type": "uint8",
                        "star": 1
                    },
                    {
                        "n": "is_submit",
                        "note": "Form submit fired (0/1). Observed from the native submit event, including submits via Enter. For form CVR.",
                        "type": "uint8"
                    }
                ],
                "star": 1
            },
            {
                "fam": "Exploration behavior",
                "kind": "signal",
                "desc": "Re-reading, skimming and hesitant mouse movement. Measures how well navigation works.",
                "cols": [
                    {
                        "n": "scroll_back_count",
                        "note": "Times the reader jumped back up 1000px or more within 3 seconds, i.e. re-reading.",
                        "type": "uint8",
                        "star": 1
                    },
                    {
                        "n": "content_skip_count",
                        "note": "Times the reader skipped down 1000px or more, i.e. content that went unread.",
                        "type": "uint8",
                        "star": 1
                    },
                    {
                        "n": "exploration_count",
                        "note": "Times the mouse swept back and forth horizontally, i.e. hunting for something to click.",
                        "type": "uint8",
                        "star": 1
                    }
                ],
                "star": 1
            },
            {
                "fam": "Raw-data presence flags",
                "kind": "signal",
                "desc": "Whether scroll / click / event raw data exists for that pageview (as a count). neq:0 finds heatmap-eligible pageviews from the column DB alone.",
                "cols": [
                    {
                        "n": "is_raw_p",
                        "note": "Count of scroll raw data (raw_p) held, 0/1/2 and up. neq:0 selects heatmap-eligible pageviews.",
                        "type": "uint8",
                        "since": "2026-07-09"
                    },
                    {
                        "n": "is_raw_c",
                        "note": "Count of click raw data (raw_c) held, 0/1/2 and up. neq:0 selects pageviews eligible for a click heatmap.",
                        "type": "uint8",
                        "since": "2026-07-09"
                    },
                    {
                        "n": "is_raw_e",
                        "note": "Count of event raw data (raw_e) held, 0/1/2 and up. neq:0 selects pageviews with recorded events.",
                        "type": "uint8",
                        "since": "2026-07-09"
                    }
                ]
            },
            {
                "fam": "Viewport",
                "kind": "signal",
                "desc": "Actual visible area. Useful for segmenting by responsive breakpoint.",
                "cols": [
                    {
                        "n": "window_inner_width",
                        "note": "innerWidth in px. between:768,1199 for the tablet band, gte:1200 for the desktop band.",
                        "type": "uint16"
                    },
                    {
                        "n": "window_inner_height",
                        "note": "innerHeight in px.",
                        "type": "uint16"
                    }
                ]
            },
            {
                "fam": "Page transitions",
                "kind": "signal",
                "desc": "Which page came before and after. For path analysis.",
                "cols": [
                    {
                        "n": "prev_url",
                        "note": "URL of the previous page. null on landing pageviews.",
                        "since": "2026-04-17"
                    },
                    {
                        "n": "prev_title",
                        "note": "Title of the previous page.",
                        "since": "2026-04-17"
                    },
                    {
                        "n": "next_url",
                        "note": "URL of the next page. null on exit pageviews.",
                        "since": "2026-04-17"
                    },
                    {
                        "n": "next_title",
                        "note": "Title of the next page.",
                        "since": "2026-04-17"
                    }
                ]
            },
            {
                "fam": "Source & referrer",
                "kind": "signal",
                "desc": "Where the visit came from.",
                "cols": [
                    {
                        "n": "url",
                        "note": "Page URL. Exact matches are fast via url_hash."
                    },
                    {
                        "n": "title",
                        "note": "Page title. More efficient to filter on url and keep this."
                    },
                    {
                        "n": "source_domain",
                        "note": "Referring domain. Indexed, so fast."
                    },
                    {
                        "n": "referrer",
                        "note": "Referrer."
                    },
                    {
                        "n": "utm_source",
                        "note": "Source."
                    },
                    {
                        "n": "utm_medium",
                        "note": "Medium. Unique index, so fast."
                    },
                    {
                        "n": "utm_campaign",
                        "note": "Campaign. Unique index, so fast."
                    },
                    {
                        "n": "utm_content",
                        "note": "Content."
                    },
                    {
                        "n": "utm_term",
                        "note": "Search term (utm)."
                    }
                ]
            },
            {
                "fam": "Device & user",
                "kind": "signal",
                "desc": "Device, OS, language and country.",
                "cols": [
                    {
                        "n": "device_type",
                        "note": "One of three values: PC / SP / tablet. Case matters."
                    },
                    {
                        "n": "os",
                        "note": "OS (UAos). Indexed, so fast."
                    },
                    {
                        "n": "browser",
                        "note": "Browser (UAbrowser)."
                    },
                    {
                        "n": "language",
                        "note": "Language."
                    },
                    {
                        "n": "country_code",
                        "note": "Country code, roughly 200 values. Indexed, so fast."
                    },
                    {
                        "n": "ua",
                        "note": "Composed UA string. Filtering on it directly is discouraged; use os and browser instead."
                    },
                    {
                        "n": "original_id",
                        "note": "Original ID. Indexed, so fast."
                    }
                ]
            },
            {
                "fam": "Page-type flags",
                "kind": "signal",
                "desc": "Page kind, classified automatically (generated column). Filter directly on is_*.",
                "cols": [
                    {
                        "n": "page_type",
                        "note": "Page type as a bit flag. Filtering on is_* is normally more efficient."
                    },
                    {
                        "n": "page_fetch_status",
                        "note": "HTML fetch status. 1 = success, -1 = failure."
                    },
                    {
                        "n": "is_article",
                        "note": "Article (0/1)."
                    },
                    {
                        "n": "is_product",
                        "note": "Product (0/1)."
                    },
                    {
                        "n": "is_list",
                        "note": "Listing (0/1)."
                    },
                    {
                        "n": "is_form",
                        "note": "Form (0/1)."
                    },
                    {
                        "n": "is_trust_info",
                        "note": "Trust information (0/1)."
                    },
                    {
                        "n": "is_faq",
                        "note": "FAQ (0/1)."
                    },
                    {
                        "n": "is_landing",
                        "note": "Landing (0/1)."
                    },
                    {
                        "n": "is_search",
                        "note": "Search results (0/1)."
                    },
                    {
                        "n": "is_account",
                        "note": "Account (0/1)."
                    },
                    {
                        "n": "is_cart",
                        "note": "Cart (0/1)."
                    },
                    {
                        "n": "is_checkout",
                        "note": "Checkout (0/1)."
                    },
                    {
                        "n": "is_confirm",
                        "note": "Confirmation (0/1)."
                    },
                    {
                        "n": "is_thanks",
                        "note": "Thank-you (0/1)."
                    },
                    {
                        "n": "is_top_page",
                        "note": "Top page (0/1)."
                    },
                    {
                        "n": "is_event",
                        "note": "Event (0/1)."
                    },
                    {
                        "n": "is_recipe",
                        "note": "Recipe (0/1)."
                    },
                    {
                        "n": "is_job",
                        "note": "Job posting (0/1)."
                    },
                    {
                        "n": "is_video",
                        "note": "Video (0/1)."
                    },
                    {
                        "n": "is_howto",
                        "note": "How-to (0/1)."
                    },
                    {
                        "n": "is_qa_forum",
                        "note": "Q&A forum (0/1)."
                    }
                ]
            },
            {
                "fam": "Goal completion",
                "kind": "signal",
                "desc": "Whether each configured goal was met. The definitions live in sites[].goals in /guide.",
                "cols": [
                    {
                        "n": "is_goal_1",
                        "note": "Goal 1 met (0/1).",
                        "type": "uint8"
                    },
                    {
                        "n": "is_goal_2",
                        "note": "Goal 2 met (0/1).",
                        "type": "uint8"
                    },
                    {
                        "n": "is_goal_3",
                        "note": "Goal 3 met (0/1).",
                        "type": "uint8"
                    },
                    {
                        "n": "is_goal_4",
                        "note": "Goal 4 met (0/1).",
                        "type": "uint8"
                    },
                    {
                        "n": "is_goal_5",
                        "note": "Goal 5 met (0/1).",
                        "type": "uint8"
                    },
                    {
                        "n": "is_goal_6",
                        "note": "Goal 6 met (0/1).",
                        "type": "uint8"
                    },
                    {
                        "n": "is_goal_7",
                        "note": "Goal 7 met (0/1).",
                        "type": "uint8"
                    },
                    {
                        "n": "is_goal_8",
                        "note": "Goal 8 met (0/1).",
                        "type": "uint8"
                    },
                    {
                        "n": "is_goal_9",
                        "note": "Goal 9 met (0/1).",
                        "type": "uint8"
                    },
                    {
                        "n": "is_goal_10",
                        "note": "Goal 10 met (0/1).",
                        "type": "uint8"
                    }
                ]
            }
        ]
    },
    "click_event": {
        "grain": "1 row = 1 click",
        "supports_all": true,
        "blurb": "Raw data in which every click is stored automatically. Carries the selector and coordinates, and joins to the raw pageview log.",
        "groups": [
            {
                "fam": "Keys & IDs",
                "kind": "key",
                "desc": "Keys for joining to allpv.",
                "cols": [
                    {
                        "n": "pv_id",
                        "note": "Which pageview the click happened on. Joins to allpv.",
                        "type": "uint32",
                        "join": 1
                    },
                    {
                        "n": "session_id",
                        "note": "Per session.",
                        "type": "uint64",
                        "join": 1
                    },
                    {
                        "n": "page_id",
                        "note": "Per page.",
                        "type": "uint32",
                        "join": 1
                    }
                ]
            },
            {
                "fam": "What was clicked",
                "kind": "signal",
                "desc": "What was pressed and when. event_sec tells you whether they read before clicking.",
                "cols": [
                    {
                        "n": "event_sec",
                        "note": "Seconds from page display to the click.",
                        "type": "uint16",
                        "star": 1
                    },
                    {
                        "n": "element_text",
                        "note": "Text of the clicked element.",
                        "type": "uint32"
                    },
                    {
                        "n": "selector",
                        "note": "CSS selector.",
                        "type": "uint32"
                    },
                    {
                        "n": "to_url",
                        "note": "Destination URL.",
                        "type": "uint32"
                    },
                    {
                        "n": "is_external",
                        "note": "External link (0/1).",
                        "type": "uint8"
                    },
                    {
                        "n": "action_id",
                        "note": "What was clicked, as an observed fact. 1: click / 2: form (a click inside a form area) / 3: tel / 4: mailto.",
                        "type": "uint8"
                    },
                    {
                        "n": "element_id",
                        "note": "Element id.",
                        "type": "uint32"
                    },
                    {
                        "n": "element_class",
                        "note": "Element class.",
                        "type": "uint32"
                    },
                    {
                        "n": "element_data",
                        "note": "data attribute.",
                        "type": "uint32"
                    }
                ],
                "star": 1
            },
            {
                "fam": "Click coordinates",
                "kind": "signal",
                "desc": "Click position in %. For heatmap-style aggregation.",
                "cols": [
                    {
                        "n": "page_x_pct",
                        "note": "Click X position in %.",
                        "type": "uint16"
                    },
                    {
                        "n": "page_y_pct",
                        "note": "Click Y position in %. For analysing upper vs lower page.",
                        "type": "uint16"
                    }
                ]
            }
        ]
    },
    "gsc": {
        "grain": "1 row = (page x query x day x search surface)",
        "supports_all": false,
        "blurb": "Search Console stored at (page x query x day) grain. Joins to the raw pageview log.",
        "groups": [
            {
                "fam": "Keys & IDs",
                "kind": "key",
                "desc": "page_id is N:M against allpv. Joining with no filter multiplies the rows out (a Cartesian product, i.e. row explosion), so narrow on url or keyword first, then join.",
                "cols": [
                    {
                        "n": "page_id",
                        "note": "Per page. N:M against allpv. An unfiltered join explodes the row count, so narrow first.",
                        "type": "uint32",
                        "join": 1
                    },
                    {
                        "n": "query_id",
                        "note": "Keyword ID. Search on keyword to get a set of query_id.",
                        "type": "uint32"
                    },
                    {
                        "n": "search_type",
                        "note": "1 = web, 2 = image, 3 = video.",
                        "type": "uint8"
                    }
                ]
            },
            {
                "fam": "Search performance",
                "kind": "signal",
                "desc": "Clicks, impressions, CTR and position. position is rewritten into a column DB scan, so it is fast.",
                "cols": [
                    {
                        "n": "clicks",
                        "note": "Daily clicks.",
                        "type": "uint32",
                        "star": 1
                    },
                    {
                        "n": "impressions",
                        "note": "Daily impressions.",
                        "type": "uint32",
                        "star": 1
                    },
                    {
                        "n": "ctr",
                        "note": "clicks / impressions. Computed at execution time (post_filter).",
                        "star": 1
                    },
                    {
                        "n": "position",
                        "note": "Average position. Rewritten to position_x100 so it can be scanned in the column DB, which is fast.",
                        "star": 1
                    },
                    {
                        "n": "position_weighted",
                        "note": "position x impressions. For weighted averages."
                    },
                    {
                        "n": "position_x100",
                        "note": "Raw value of position x 100.",
                        "type": "uint16"
                    }
                ],
                "star": 1
            },
            {
                "fam": "Time dimension",
                "kind": "signal",
                "desc": "A gsc row carries no date of its own. This is the axis to use when you want monthly aggregation.",
                "cols": [
                    {
                        "n": "month",
                        "note": "Month the row belongs to (YYYY-MM). Derived from the date Storage injects as it loops over the daily files. Put it in keep to aggregate by month. Narrow the period with time instead.",
                        "since": "2026-08-05"
                    }
                ]
            },
            {
                "fam": "Resolved columns",
                "kind": "signal",
                "desc": "Labels resolved from query_id and page_id.",
                "cols": [
                    {
                        "n": "keyword",
                        "note": "Search query. Resolved from query_id."
                    },
                    {
                        "n": "url",
                        "note": "Page URL."
                    },
                    {
                        "n": "title",
                        "note": "Page title."
                    },
                    {
                        "n": "page_type",
                        "note": "Page type."
                    },
                    {
                        "n": "page_fetch_status",
                        "note": "Fetch status."
                    }
                ]
            }
        ]
    },
    "page_version": {
        "grain": "1 row = one version of a page",
        "supports_all": false,
        "blurb": "Version history of page content. Lets you compare before and after a revision without mixing the two.",
        "groups": [
            {
                "fam": "Keys & IDs",
                "kind": "key",
                "desc": "Joins to allpv.version_id. Versions are tracked per page x device, because PC and SP use different templates and so have separate revision histories. That is why device_id is part of the key.",
                "cols": [
                    {
                        "n": "version_id",
                        "note": "PK, and the join key against allpv.version_id.",
                        "join": 1
                    },
                    {
                        "n": "page_id",
                        "note": "Page identifier. Narrowing by URL in allpv and then joining is recommended.",
                        "join": 1
                    },
                    {
                        "n": "device_id",
                        "note": "1=PC, 2=tablet, 3=SP. Part of the key because PC, SP and tablet each have their own revision history."
                    }
                ]
            },
            {
                "fam": "Version metadata",
                "kind": "signal",
                "desc": "Version number, creation date and URL.",
                "cols": [
                    {
                        "n": "version_no",
                        "note": "Version number within the same page x device. 1 is the first version. calc MAX() gives the latest."
                    },
                    {
                        "n": "update_date",
                        "note": "Date the version was created. For finding changes made on a particular day."
                    },
                    {
                        "n": "url",
                        "note": "URL."
                    },
                    {
                        "n": "title",
                        "note": "Title."
                    },
                    {
                        "n": "device_type",
                        "note": "PC / SP / tablet."
                    }
                ]
            }
        ]
    },
    "summary_allpage": {
        "grain": "1 row = period totals per page x dimension",
        "supports_all": true,
        "blurb": "Returns summary data for every page. Convenient for per-page aggregation.",
        "groups": [
            {
                "fam": "Grouping dimensions",
                "kind": "key",
                "desc": "The axes you aggregate along. Kept as numeric IDs; device_type is added for you.",
                "cols": [
                    {
                        "n": "page_id",
                        "note": "Page identifier. Use this material for rankings.",
                        "type": "uint32"
                    },
                    {
                        "n": "device_id",
                        "note": "1=PC, 2=tablet, 3=SP. device_type is added for you.",
                        "type": "uint8"
                    },
                    {
                        "n": "utm_source",
                        "note": "Source, with the label already resolved."
                    },
                    {
                        "n": "utm_medium",
                        "note": "Medium."
                    },
                    {
                        "n": "utm_campaign",
                        "note": "Campaign."
                    },
                    {
                        "n": "source_domain",
                        "note": "Referring domain."
                    },
                    {
                        "n": "is_newuser",
                        "note": "New (1) or returning (0).",
                        "type": "uint8"
                    },
                    {
                        "n": "is_QA",
                        "note": "Flag for traffic that came through QA.",
                        "type": "uint8"
                    }
                ]
            },
            {
                "fam": "Cumulative measures",
                "kind": "signal",
                "desc": "Totals over the period. Numeric range filters run as post_filter.",
                "cols": [
                    {
                        "n": "pv_count",
                        "note": "Total pageviews over the period.",
                        "type": "uint32"
                    },
                    {
                        "n": "user_count",
                        "note": "Total users over the period.",
                        "type": "uint32"
                    },
                    {
                        "n": "bounce_count",
                        "note": "Total bounces over the period.",
                        "type": "uint32"
                    },
                    {
                        "n": "exit_count",
                        "note": "Total exits over the period.",
                        "type": "uint32"
                    },
                    {
